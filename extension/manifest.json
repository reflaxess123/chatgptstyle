{
  "manifest_version": 3,
  "name": "ChatGPT Compact Style",
  "description": "CSS-only compact layout and JetBrains Mono styling for chatgpt.com.",
  "version": "0.1.0",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*"
  ]
}
